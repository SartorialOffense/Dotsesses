<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotsesses.UI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Dotsesses.UI.CorrelationPlotControl"
             x:DataType="vm:CorrelationPlotViewModel"
             Background="Transparent">

    <Grid>
        <!-- Main plot area -->
        <Grid x:Name="CorrelationPlotArea" PointerMoved="OnPointerMoved" PointerPressed="OnPlotAreaClick" Background="Transparent">
            <!-- SVG Background -->
            <Image x:Name="SvgView" Stretch="Fill" />

            <!-- Canvas for swarm point overlays -->
            <Canvas x:Name="PointsOverlay" Background="Transparent" />

            <!-- Canvas for tooltips -->
            <Canvas x:Name="TooltipsOverlay" IsHitTestVisible="False" />
        </Grid>

        <!-- Controls overlay (top-right) -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="0,4,4,0">

            <!-- Diagonal type toggle button -->
            <Button x:Name="DiagonalToggleButton"
                    Width="28" Height="28"
                    Background="#3A3A3C"
                    Foreground="White"
                    BorderThickness="0"
                    CornerRadius="4"
                    Opacity="0.7"
                    ToolTip.Tip="Toggle diagonal: KDE / Histogram">
                <TextBlock x:Name="DiagonalToggleIcon" Text="~" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- Copy button -->
            <Button x:Name="CopyCorrelationPlotButton"
                    Width="28" Height="28"
                    Background="#3A3A3C"
                    Foreground="White"
                    BorderThickness="0"
                    CornerRadius="4"
                    Opacity="0.7"
                    ToolTip.Tip="Copy to clipboard (inverted for print)">
                <TextBlock Text="&#x1F4CB;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- Exploratory caveat (ADR-0018): leads are not confirmation. -->
        <TextBlock Text="Exploratory — uncorrected; treat as leads, not confirmation"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="6,0,0,4"
                   FontSize="10" FontStyle="Italic"
                   Opacity="0.6"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
