<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotsesses.UI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Dotsesses.UI.TsnePlotControl"
             x:DataType="vm:TsnePlotViewModel"
             Background="Transparent">

    <Grid RowDefinitions="Auto,*">
        <!-- Parameter sliders panel -->
        <Border x:Name="SlidersPanel"
                Grid.Row="0"
                Background="#2D2D30"
                Padding="8,6"
                CornerRadius="0,0,4,4">
            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto,*,Auto">
                <!-- perplexity slider -->
                <TextBlock Grid.Column="0"
                           Text="Perplexity:"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <Slider Grid.Column="1"
                        x:Name="PerplexitySlider"
                        Minimum="5"
                        Maximum="50"
                        Value="{Binding Perplexity}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        Width="120"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Perplexity, StringFormat={}{0:F0}}"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           Width="24"
                           VerticalAlignment="Center"/>

                <!-- learning_rate slider -->
                <TextBlock Grid.Column="4"
                           Text="Learn Rate:"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <Slider Grid.Column="5"
                        x:Name="LearningRateSlider"
                        Minimum="10"
                        Maximum="1000"
                        Value="{Binding LearningRate}"
                        TickFrequency="10"
                        Width="120"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6"
                           Text="{Binding LearningRate, StringFormat={}{0:F0}}"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           Width="36"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main plot area -->
        <Grid x:Name="TsnePlotArea" Grid.Row="1" PointerMoved="OnPointerMoved" PointerPressed="OnPlotAreaClick" Background="Transparent">
            <!-- SVG Background -->
            <Image x:Name="SvgView" Stretch="Fill" />

            <!-- Canvas for point overlays -->
            <Canvas x:Name="PointsOverlay" Background="Transparent" />
        </Grid>

        <!-- Loading spinner -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="1"
                Background="#80000000"
                IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Computing t-SNE..."
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Controls overlay (top-right) -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="0,4,4,0">

            <!-- Copy button -->
            <Button x:Name="CopyTsnePlotButton"
                    Width="28" Height="28"
                    Background="#3A3A3C"
                    Foreground="White"
                    BorderThickness="0"
                    CornerRadius="4"
                    Opacity="0.7"
                    ToolTip.Tip="Copy to clipboard (inverted for print)">
                <TextBlock Text="&#x1F4CB;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
