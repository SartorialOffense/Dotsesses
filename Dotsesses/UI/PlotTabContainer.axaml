<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotsesses.UI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Dotsesses.UI.PlotTabContainer"
             x:DataType="vm:PlotTabContainerViewModel"
             Background="Transparent">

    <Grid RowDefinitions="Auto,*">
        <!-- Tab Header Row -->
        <Border Grid.Row="0" Background="#101010" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="0">
                <!-- Distribution Tab -->
                <Button Command="{Binding SelectViolinCommand}"
                        Classes="tab-button"
                        Classes.selected="{Binding IsViolinSelected}">
                    <TextBlock Text="Distribution" />
                </Button>

                <!-- Separator -->
                <Border Width="1" Height="16" Background="#333333" Margin="8,0" VerticalAlignment="Center" />

                <!-- Correlation Tab -->
                <Button Command="{Binding SelectCorrelationCommand}"
                        Classes="tab-button"
                        Classes.selected="{Binding IsCorrelationSelected}">
                    <TextBlock Text="Correlation" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Violin Plot -->
            <vm:ViolinPlotControl DataContext="{Binding ViolinPlotViewModel}"
                                  IsVisible="{Binding $parent[UserControl].((vm:PlotTabContainerViewModel)DataContext).IsViolinSelected}" />

            <!-- Correlation Plot -->
            <vm:CorrelationPlotControl DataContext="{Binding CorrelationPlotViewModel}"
                                       IsVisible="{Binding $parent[UserControl].((vm:PlotTabContainerViewModel)DataContext).IsCorrelationSelected}" />
        </Grid>
    </Grid>

    <UserControl.Styles>
        <!-- Base tab button style -->
        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Hover state -->
        <Style Selector="Button.tab-button:pointerover">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Selected state -->
        <Style Selector="Button.tab-button.selected">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Selected + hover -->
        <Style Selector="Button.tab-button.selected:pointerover">
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Pressed state -->
        <Style Selector="Button.tab-button:pressed">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>
</UserControl>
