<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dotsesses.UI"
        x:Class="Dotsesses.UI.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="840" Height="500"
        MinWidth="700" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid RowDefinitions="*,Auto" Margin="20">

        <!-- Tabbed settings surface (Score Selection is the first/only tab today). -->
        <TabControl Grid.Row="0">
            <TabItem Header="Score Selection">
                <Grid RowDefinitions="Auto,*">

                    <!-- Header row: column titles + per-column All/None bulk-toggle buttons.
                         Column widths must match the row DataTemplate's columns below. -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="100"/>
                            <!-- Aggregate column — collapses to 0 when hidden (TD010). -->
                            <ColumnDefinition Width="{Binding AggregateColumnWidth}"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Score"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <!-- Type column: no All/None bulk toggle — bulk-flipping type
                             is almost certainly user error and silently moves data
                             between Scores / Attributes lists. -->
                        <TextBlock Grid.Column="1"
                                   Text="Type"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Display"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <!-- Special-case: tiny column-header bulk-toggle buttons, intentionally compact. Inline styling preserved. -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <Button Content="All"
                                        Command="{Binding DisplayAllCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                                <Button Content="None"
                                        Command="{Binding DisplayNoneCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding ShowAggregateColumn}"><!-- hidden in spreadsheet-Total mode (TD010) -->
                            <TextBlock Text="Aggregate"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <!-- Special-case: tiny column-header bulk-toggle buttons, intentionally compact. Inline styling preserved. -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <Button Content="All"
                                        Command="{Binding AggregateAllCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                                <!-- AggregateNoneCommand is permanently disabled (canExecute:false)
                                     because clearing every Aggregate row is structurally invalid. -->
                                <Button Content="None"
                                        Command="{Binding AggregateNoneCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Associations"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <!-- Special-case: tiny column-header bulk-toggle buttons, intentionally compact. Inline styling preserved. -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <Button Content="All"
                                        Command="{Binding CorrelationAllCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                                <Button Content="None"
                                        Command="{Binding CorrelationNoneCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="5"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Group Differences"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <!-- Special-case: tiny column-header bulk-toggle buttons, intentionally compact. Inline styling preserved. -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <Button Content="All"
                                        Command="{Binding SignificanceAllCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                                <Button Content="None"
                                        Command="{Binding SignificanceNoneCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="6"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Bias Correct"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       ToolTip.Tip="Rest-score de-bias: correlate this column against Total − this column, instead of the full Total. For columns whose value is contained in Total (aggregate components, or composites like Q1-Q4). Independent of Aggregate."/>
                            <!-- Special-case: tiny column-header bulk-toggle buttons, intentionally compact. Inline styling preserved. -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <Button Content="All"
                                        Command="{Binding BiasCorrectAllCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                                <Button Content="None"
                                        Command="{Binding BiasCorrectNoneCommand}"
                                        Padding="6,2"
                                        FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Data rows. Per-row Type combobox + checkboxes bind into the row VM directly;
                         the Aggregate column disables itself for locked (Total) rows via the
                         IsAggregateLocked->negated binding. Display/Aggregate/Correlation
                         additionally disable when the row is Categorical (those flags don't
                         apply when the column's data lives in Attributes). -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScoreSelectionRowViewModel">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="100"/>
                                            <!-- Aggregate column — collapses to 0 when hidden (TD010). -->
                                            <ColumnDefinition Width="{Binding AggregateColumnWidth}"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TypeOptions}"
                                                  SelectedItem="{Binding Type}"
                                                  IsEnabled="{Binding !IsTypeLocked}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  MinWidth="120"/>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding Display}"
                                                  IsEnabled="{Binding IsNumeric}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="3"
                                                  IsChecked="{Binding Aggregate}"
                                                  IsEnabled="{Binding IsAggregateEditable}"
                                                  IsVisible="{Binding ShowAggregateColumn}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="4"
                                                  IsChecked="{Binding Correlation}"
                                                  IsEnabled="{Binding IsNumeric}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="5"
                                                  IsChecked="{Binding Significance}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="6"
                                                  IsChecked="{Binding BiasCorrect}"
                                                  IsEnabled="{Binding IsBiasCorrectEditable}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Apply / Dismiss button row. Dismiss label is dynamic ('Cancel' when dirty, 'Close' when clean) per R009. -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,15,0,0">
            <Button Classes="dialog-primary"
                    Content="Apply"
                    Click="OnApplyClick"/>
            <Button Classes="dialog-secondary"
                    Content="{Binding DismissButtonLabel}"
                    Click="OnDismissClick"/>
        </StackPanel>
    </Grid>
</Window>
