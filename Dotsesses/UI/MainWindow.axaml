<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dotsesses.UI"
        xmlns:local="using:Dotsesses.UI"
        xmlns:models="using:Dotsesses.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Dotsesses.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Dotsesses - Grade Distribution"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Outer container for splitter-colored background -->
    <Border BorderThickness="0" Background="#202020">
    <Grid RowDefinitions="Auto,100,2,*">
        <!-- Debug Row: Velocity Display (hidden) -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="4" HorizontalAlignment="Right" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Velocity:" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding HoverDelayService.CurrentVelocity, StringFormat='{}{0:F0} px/s'}"
                          Foreground="#00FF00" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="60"/>
            </StackPanel>
        </Border>

        <!-- Top Row: Dotplot -->
        <Border Grid.Row="1" Background="#101010" CornerRadius="8">
                <Grid>
                    <oxy:PlotView x:Name="DotPlotView" Model="{Binding DotplotModel}" Background="Transparent">
                        <oxy:PlotView.Cursor>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <local:ResizeCursorConverter/>
                                </MultiBinding.Converter>
                                <Binding Path="IsResizeCursor"/>
                            </MultiBinding>
                        </oxy:PlotView.Cursor>
                    </oxy:PlotView>
                    <!-- Canvas overlay for hover marker in screen coordinates -->
                    <Canvas x:Name="DotPlotHoverOverlay" Background="Transparent" IsHitTestVisible="False" />
                </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"
                      Background="#202020"/>

        <!-- Bottom Row: Drill-Down and Violin Plot with Horizontal Expanders -->
        <Border Grid.Row="3">
            <Grid ColumnDefinitions="300,2,*">

                <!-- Left: Drill-Down Panel (Student Card) -->
                <Border Grid.Column="0" Background="#101010" CornerRadius="8">
                    <ContentControl Content="{Binding HoveredStudent}"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Stretch">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:StudentCardViewModel">
                                <Border                                        BorderThickness="0"
                                       CornerRadius="4"
                                       Padding="15"
                                       HorizontalAlignment="Stretch">
                                                        <Grid RowDefinitions="Auto,Auto">
                                                            <!-- Header: Name, Grade, and Clear button -->
                                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                                                                <TextBlock Grid.Column="0"
                                                                         Text="{Binding Assessment.MuppetName}"
                                                                         Foreground="White"
                                                                         FontWeight="SemiBold"
                                                                         FontSize="14"
                                                                         TextWrapping="Wrap"/>
                                                                <Border Grid.Column="1"
                                                                       Background="#007ACC"
                                                                       CornerRadius="3"
                                                                       Padding="8,4"
                                                                       Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding AssignedGrade}"
                                                                             Foreground="White"
                                                                             FontWeight="Bold"
                                                                             FontSize="14"/>
                                                                </Border>
                                                                <Button Grid.Column="2"
                                                                       Content="X"
                                                                       Command="{Binding ClearCommand}"
                                                                       Foreground="#888888"
                                                                       BorderThickness="0"
                                                                       FontSize="12"
                                                                       Padding="6,2"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="Clear selection"/>
                                                            </Grid>

                                                            <!-- Single merged table: Scores first, then Attributes -->
                                                            <StackPanel Grid.Row="1">
                                                                <!-- Scores with per-score comments -->
                                                                <ItemsControl ItemsSource="{Binding Assessment.Scores}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:Score">
                                                                            <StackPanel Margin="0,2,0,6">
                                                                                <!-- Score name and value row -->
                                                                                <Grid ColumnDefinitions="*,Auto">
                                                                                    <TextBlock Grid.Column="0"
                                                                                             Text="{Binding Name}"
                                                                                             Foreground="#AAAAAA"
                                                                                             FontSize="11"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                             Text="{Binding Value, StringFormat='{}{0:0}'}"
                                                                                             Foreground="White"
                                                                                             FontSize="11"
                                                                                             FontWeight="Medium"/>
                                                                                </Grid>
                                                                                <!-- Editable comment TextBox (auto-sizing) -->
                                                                                <TextBox Text="{Binding Comment, Mode=TwoWay}"
                                                                                        TextWrapping="Wrap"
                                                                                        AcceptsReturn="True"
                                                                                        Foreground="#CCCCCC"
                                                                                        BorderBrush="#3F3F46"
                                                                                        BorderThickness="1"
                                                                                        FontSize="10"
                                                                                        Padding="4"
                                                                                        Margin="0,2,0,0"
                                                                                        Watermark="Add comment..."
                                                                                        UseFloatingWatermark="False"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- Separator line -->
                                                                <Border Height="1"
                                                                       Margin="0,8"
                                                                       HorizontalAlignment="Stretch"/>

                                                                <!-- Attributes -->
                                                                <ItemsControl ItemsSource="{Binding Assessment.Attributes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2" TextElement.Foreground="White">
                                                                                <TextBlock Grid.Column="0"
                                                                                         Text="{Binding Name}"
                                                                                         Foreground="#AAAAAA"
                                                                                         FontSize="11"/>
                                                                                <TextBlock Grid.Column="1"
                                                                                         Text="{Binding Value}"
                                                                                         FontSize="11"
                                                                                         FontWeight="Medium"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                            </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <!-- Vertical Splitter -->
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              VerticalAlignment="Stretch"
                              Background="#202020"/>

                <!-- Right: Violin Plot Panel -->
                <Border Grid.Column="2" Background="#101010" CornerRadius="8">
                    <local:ViolinPlotControl DataContext="{Binding ViolinPlotViewModel}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
