<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dotsesses.UI"
        xmlns:local="using:Dotsesses.UI"
        xmlns:models="using:Dotsesses.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Dotsesses.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding SourceFileName, StringFormat='Dotsesses - {0}'}"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Outer container for splitter-colored background -->
    <Border BorderThickness="0" Background="#202020">
    <Grid RowDefinitions="Auto,100,2,*">
        <!-- Debug Row: Velocity Display (hidden) -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="4" HorizontalAlignment="Right" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Velocity:" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding HoverDelayService.CurrentVelocity, StringFormat='{}{0:F0} px/s'}"
                          Foreground="#00FF00" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="60"/>
            </StackPanel>
        </Border>

        <!-- Top Row: Dotplot -->
        <Border x:Name="DotPlotBorder" Grid.Row="1" Background="#101010" CornerRadius="0"
                BorderThickness="1" BorderBrush="Transparent">
            <Grid>
                <!-- Existing content -->
                <Grid x:Name="DotPlotContainer">
                    <oxy:PlotView x:Name="DotPlotView" Model="{Binding DotplotModel}" Background="Transparent">
                        <oxy:PlotView.Cursor>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <local:ResizeCursorConverter/>
                                </MultiBinding.Converter>
                                <Binding Path="IsResizeCursor"/>
                            </MultiBinding>
                        </oxy:PlotView.Cursor>
                    </oxy:PlotView>
                    <!-- Canvas overlay for hover marker in screen coordinates -->
                    <Canvas x:Name="DotPlotHoverOverlay" Background="Transparent" IsHitTestVisible="False" />
                </Grid>

                <!-- Copy button overlay -->
                <Button x:Name="CopyDotPlotButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,24,4,0"
                        Width="28" Height="28"
                        Background="#3A3A3C"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="4"
                        Opacity="0.7"
                        ToolTip.Tip="Copy to clipboard (inverted for print)">
                    <TextBlock Text="&#x1F4CB;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"
                      Background="#202020"/>

        <!-- Bottom Row: Drill-Down and Violin Plot with Horizontal Expanders -->
        <Border Grid.Row="3">
            <Grid ColumnDefinitions="300,2,*">

                <!-- Left: Drill-Down Panel (Save/Export buttons + Student Card + Compliance Table) -->
                <Border Grid.Column="0" Background="#101010" CornerRadius="8">
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <!-- Save/Export Buttons -->
                        <Border Grid.Row="0" BorderBrush="#202020" BorderThickness="0,0,0,2" Padding="10,6,10,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveButton"
                                        FontSize="12"
                                        Padding="12,3"
                                        Background="#2D2D30"
                                        Foreground="White"
                                        BorderThickness="1"
                                        BorderBrush="#3F3F46"
                                        CornerRadius="4"
                                        ToolTip.Tip="Save state to file">
                                    <Grid ColumnDefinitions="Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="💾" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="0" Text="●" FontSize="8" Margin="0,4,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{Binding HasUnsavedChanges, Converter={x:Static local:BoolToColorConverter.Instance}}"/>
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="Save" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="ExportButton"
                                        Content="📊 Export"
                                        FontSize="12"
                                        Padding="12,3"
                                        Background="#2D2D30"
                                        Foreground="White"
                                        BorderThickness="1"
                                        BorderBrush="#3F3F46"
                                        CornerRadius="4"
                                        ToolTip.Tip="Export grades to Excel"/>
                                <Button x:Name="ExportPptxButton"
                                        Content="📽️ PPTX"
                                        FontSize="12"
                                        Padding="12,3"
                                        Background="#2D2D30"
                                        Foreground="White"
                                        BorderThickness="1"
                                        BorderBrush="#3F3F46"
                                        CornerRadius="4"
                                        ToolTip.Tip="Export presentation with plots"/>
                            </StackPanel>
                        </Border>

                        <!-- Student Card -->
                        <ContentControl Grid.Row="1" Content="{Binding HoveredStudent}"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Stretch">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:StudentCardViewModel">
                                <Border                                        BorderThickness="0"
                                       CornerRadius="4"
                                       Padding="15"
                                       HorizontalAlignment="Stretch">
                                                        <Grid RowDefinitions="Auto,Auto">
                                                            <!-- Header: ID, Name, Grade, and Clear button -->
                                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
                                                                <TextBlock Grid.Column="0"
                                                                         Text="{Binding Assessment.Id}"
                                                                         Foreground="#888888"
                                                                         FontWeight="SemiBold"
                                                                         FontSize="14"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="1"
                                                                         Text="{Binding Assessment.MuppetName}"
                                                                         Foreground="White"
                                                                         FontWeight="SemiBold"
                                                                         FontSize="14"
                                                                         VerticalAlignment="Center"
                                                                         TextWrapping="Wrap"/>
                                                                <Border Grid.Column="2"
                                                                       Background="#007ACC"
                                                                       CornerRadius="3"
                                                                       Padding="8,4"
                                                                       Margin="10,0,0,0"
                                                                       VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AssignedGrade}"
                                                                             Foreground="White"
                                                                             FontWeight="Bold"
                                                                             FontSize="14"/>
                                                                </Border>
                                                                <Button Grid.Column="3"
                                                                       Content="X"
                                                                       Command="{Binding ClearCommand}"
                                                                       Foreground="#888888"
                                                                       BorderThickness="0"
                                                                       FontSize="12"
                                                                       Padding="6,2"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="Clear selection"/>
                                                            </Grid>

                                                            <!-- Single merged table: Scores first, then Attributes -->
                                                            <StackPanel Grid.Row="1">
                                                                <!-- Scores with per-score comments -->
                                                                <ItemsControl ItemsSource="{Binding Assessment.Scores}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:Score">
                                                                            <StackPanel Margin="0,2,0,6">
                                                                                <!-- Score name and value row -->
                                                                                <Grid ColumnDefinitions="*,Auto">
                                                                                    <TextBlock Grid.Column="0"
                                                                                             Text="{Binding Name}"
                                                                                             FontSize="11">
                                                                                        <TextBlock.Foreground>
                                                                                            <MultiBinding Converter="{StaticResource ScoreColorConverter}">
                                                                                                <Binding Path="."/>
                                                                                                <ReflectionBinding Path="Content.SeriesColorMap" RelativeSource="{RelativeSource AncestorType=ContentControl}"/>
                                                                                            </MultiBinding>
                                                                                        </TextBlock.Foreground>
                                                                                    </TextBlock>
                                                                                    <TextBlock Grid.Column="1"
                                                                                             Text="{Binding Value, StringFormat='{}{0:0}'}"
                                                                                             FontSize="11"
                                                                                             FontWeight="Medium">
                                                                                        <TextBlock.Foreground>
                                                                                            <MultiBinding Converter="{StaticResource ScoreColorConverter}">
                                                                                                <Binding Path="."/>
                                                                                                <ReflectionBinding Path="Content.SeriesColorMap" RelativeSource="{RelativeSource AncestorType=ContentControl}"/>
                                                                                            </MultiBinding>
                                                                                        </TextBlock.Foreground>
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                                <!-- Editable comment TextBox (auto-sizing) -->
                                                                                <TextBox Text="{Binding Comment, Mode=TwoWay}"
                                                                                        TextWrapping="Wrap"
                                                                                        AcceptsReturn="True"
                                                                                        Foreground="#CCCCCC"
                                                                                        BorderThickness="1"
                                                                                        BorderBrush="Transparent"
                                                                                        FontSize="10"
                                                                                        Padding="4"
                                                                                        Margin="0,2,0,0"
                                                                                        Watermark="Add comment..."
                                                                                        UseFloatingWatermark="False">
                                                                                    <TextBox.Background>
                                                                                        <MultiBinding Converter="{StaticResource ScoreColorWithAlphaConverter}" ConverterParameter="32">
                                                                                            <Binding Path="."/>
                                                                                            <ReflectionBinding Path="Content.SeriesColorMap" RelativeSource="{RelativeSource AncestorType=ContentControl}"/>
                                                                                        </MultiBinding>
                                                                                    </TextBox.Background>
                                                                                    <TextBox.Styles>
                                                                                        <Style Selector="TextBox:focus">
                                                                                            <Setter Property="BorderBrush">
                                                                                                <Setter.Value>
                                                                                                    <MultiBinding Converter="{StaticResource ScoreColorConverter}">
                                                                                                        <Binding Path="."/>
                                                                                                        <ReflectionBinding Path="Content.SeriesColorMap" RelativeSource="{RelativeSource AncestorType=ContentControl}"/>
                                                                                                    </MultiBinding>
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                        </Style>
                                                                                    </TextBox.Styles>
                                                                                </TextBox>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- Separator line -->
                                                                <Border Height="1"
                                                                       Margin="0,8"
                                                                       HorizontalAlignment="Stretch"/>

                                                                <!-- Attributes -->
                                                                <ItemsControl ItemsSource="{Binding Assessment.Attributes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2" TextElement.Foreground="White">
                                                                                <TextBlock Grid.Column="0"
                                                                                         Text="{Binding Name}"
                                                                                         Foreground="#AAAAAA"
                                                                                         FontSize="11"/>
                                                                                <TextBlock Grid.Column="1"
                                                                                         Text="{Binding Value}"
                                                                                         FontSize="11"
                                                                                         FontWeight="Medium"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                            </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                        <!-- Separator (same as splitter style, but not resizable) -->
                        <Border Grid.Row="2" Height="2" Background="#202020" />

                        <!-- Compliance Summary Table -->
                        <Border Grid.Row="3" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Row -->
                                <Grid Grid.Row="0" ColumnDefinitions="40,50,40,50" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="Grade" Foreground="#888888" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="Target" Foreground="#888888" FontSize="10" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="Count" Foreground="#888888" FontSize="10" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="Delta" Foreground="#888888" FontSize="10" FontWeight="SemiBold" TextAlignment="Right"/>
                                </Grid>

                                <!-- Data Rows -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ComplianceRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                                            <Grid ColumnDefinitions="40,50,40,50" Margin="0,1" IsVisible="{Binding IsEnabled}">
                                                <TextBlock Grid.Column="0" Text="{Binding Grade.DisplayName}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TargetRange}" Foreground="#AAAAAA" FontSize="11" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CurrentCount}" Foreground="White" FontSize="11" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" FontSize="11" TextAlignment="Right"
                                                           Text="{Binding SignedDeviation, StringFormat='{}{0:+#;-#;}'}"
                                                           IsVisible="{Binding HasDeviation}">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding>
                                                            <MultiBinding.Converter>
                                                                <local:DeviationColorConverter/>
                                                            </MultiBinding.Converter>
                                                            <Binding Path="SignedDeviation"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Vertical Splitter -->
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              VerticalAlignment="Stretch"
                              Background="#202020"/>

                <!-- Right: Violin Plot Panel -->
                <Border Grid.Column="2" Background="#101010" CornerRadius="8">
                    <local:ViolinPlotControl DataContext="{Binding ViolinPlotViewModel}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
