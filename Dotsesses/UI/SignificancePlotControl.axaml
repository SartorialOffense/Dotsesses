<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotsesses.UI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Dotsesses.UI.SignificancePlotControl"
             x:DataType="vm:SignificancePlotViewModel"
             Background="Transparent">

    <Grid>
        <Grid x:Name="SignificancePlotArea" Background="Transparent">
            <!-- SVG background -->
            <Image x:Name="SvgView" Stretch="Fill" />

            <!-- Per-dot interactive overlay (one Ellipse per data point with a ToolTip) -->
            <Canvas x:Name="PointsOverlay" Background="Transparent" />
        </Grid>
    </Grid>
</UserControl>
